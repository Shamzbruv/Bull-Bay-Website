# Supabase — public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://gfbeauuvicewxtuuvndf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only, NEVER expose to the browser / NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ORGANIZATION_SLUG=bull-bay

# Church tools (docs/CHURCH-TOOLS.md) — both use the separate "Bull Bay NTCOG Games" Supabase project.
# Live Countdown, server only: that project's URL and service-role key. Unset = runs from built-in
# templates and saves nothing.
# COUNTDOWN_SUPABASE_URL=
# COUNTDOWN_SUPABASE_SERVICE_KEY=
# Quiz Night, read at BUILD time and shipped to the browser: that project's URL and anon key.
# Unset = the quiz keeps quizzes in each browser only (a Railway build refuses to run without them).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Payments — leave PAYMENT_PROVIDER unset until a Jamaican merchant account is chosen.
# The app falls back to a "coming soon" checkout that records intent without charging anyone.
# PAYMENT_PROVIDER=paypal|wipay|powertranz
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# WIPAY_ACCOUNT_NUMBER=
# WIPAY_API_KEY=
# POWERTRANZ_MERCHANT_ID=
# POWERTRANZ_PASSWORD=

# Email (transactional) — optional, unset disables outbound email beyond Supabase Auth's own
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# SMS — optional, only for high-value alerts (Jamaica SMS pricing is high)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
